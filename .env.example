# AITS runtime configuration
# Copy this file to .env in the AITS project root.
# Runtime environment variables take priority; missing values may fall back to
# ../[BOOT] Scripts/global.env. Do not place another .env inside server/.

# Application
SERVER_PORT=3013
CLIENT_PORT=3014
DOMAIN=https://aits.jpano.dev

# PostgreSQL
# Use a dedicated PostgreSQL user and strong password in production.
# For a remote database, enable TLS and use sslmode=require.
POSTGRESQL_PORT=10000
DATABASE_URL=postgres://aits_app:1234567890@127.0.0.1:10000/aits?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_IDLE_MINUTES=5
DATABASE_MAX_CONN_LIFETIME_MINUTES=30
# Optional first-run restore used by compiled start launcher. Leave blank to initialize from SCHEMA.sql.
# Accepts .sql (psql) or custom .dump/.backup (pg_restore), relative to compiled AITS root or absolute.
AITS_PG_DUMP=

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
